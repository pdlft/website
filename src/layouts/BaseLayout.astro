---
import Umami from "../components/Umami.astro";
import { siteConfig } from "../config";
import "../styles.css";
import { SEO } from "astro-seo";

const { title } = Astro.props;

const realTile = title ? `${title} - ${siteConfig.title}` : siteConfig.title;

const baseSEO = {
	title: realTile,
	description: siteConfig.description,
	openGraph: {
		basic: {
			title: realTile,
			type: "website",
			image: "/og-image.png",
		},
	},
};
---

<html lang="en" class="">
	<head>
		<SEO {...baseSEO} />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/fav.ico" />
		<Umami />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{realTile}</title>
	</head>
	<body>
		<nav class="p-3 contain my-8">
			<div class="flex items-center justify-between flex-col md:flex-row gap-10">
				<a href="/" class="flex items-center gap-2">
					<img src="/images/logo.png" alt="logo" class="w-36" />
				</a>
				<div class="flex items-center gap-5 flex-col md:flex-row">
					{siteConfig.nav.map((item) => (
						<div class="flex items-center gap-2">
							<a href={item.href} target="_blank" class="flex items-center gap-1">
								<div set:html={item.icon} />
								{item.label}
							</a>
						</div>
					))}
				</div>
			</div>
		</nav>

		<slot />

		<footer class="text-center text-sm text-gray-500 my-24">
			<div class="text-center text-sm text-gray-500">
				<a href="/">Copyright © 2024 PaddingLeft</a>
			</div>
		</footer>
	</body>
</html>
